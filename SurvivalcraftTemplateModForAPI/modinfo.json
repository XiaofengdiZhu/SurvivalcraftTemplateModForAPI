// The file of mod information, please modify according to your mod.
// 模组信息文件，请根据你的模组的具体情况修改
{
  // Schema of the current json file.
  // 当前 json 文件的数据结构
  "$schema": "https://gitee.com/SC-SPM/SurvivalcraftApi/raw/SCAPI1.9/Survivalcraft/Content/modinfo-scheme.json",

  // Mod name
  // 模组名称
  "Name": "Survivalcraft Template Mod 生存战争示例模组",

  // Mod version, Semver standard is recommended: https://semver.org/
  // 模组版本，建议符合 Semver 标准： https://semver.org/lang/zh-CN/
  "Version": "1.9.3",

  // Target API version. If it is below 1.8, the game will show a compatibility warning, but will still attempt to load the mod.
  // 模组适配的 API 版本，低于 1.8 的模组将警告可能无法使用，但还是会尝试加载
  "ApiVersion": "1.9.3",

  // Mod description
  // 模组描述
  "Description": "This is a simple mod project template for Survivalcraft API 1.9.0.0 and above. 这是一个适用于生存战争插件版 1.9.0.0 及以上版本的简单模组示例项目",

  // Target Survivalcraft game version (no functional impact)
  // 模组适配的生存战争游戏版本，没有实际用处
  "ScVersion": "2.4.0.0",

  // Mod loading priority. Smaller values load earlier. Default is 0.
  // Suggested: Theme mod -100000~-10000, assistant mod 10000~100000
  // Note: Players can manually adjust the load order in-game.
  // 模组加载顺序，值越小越先加载，默认为 0
  // 建议：主题模组 -100000~-10000，辅助模组 10000~100000
  // 注意：玩家能在游戏中手动修改顺序
  "LoadOrder": 10000,

  // Non-persistent Mod
  // When true, the mod will not be recorded in world saves. Removing this mod will not trigger "missing mod" warnings.
  // 非持久性模组
  // 该项为 true 时，将不会在存档中记录该模组，从而在移除该模组后，进入存档时，不会警告未安装该模组；适用于不在存档中存储数据、添加方块、添加实体的模组
  "NonPersistentMod": true,

  // Gameplay Impact Level. Used to identify how much the mod affects game balance. Options:
  // "Cosmetic": Visual only (e.g., textures, fonts, shaders)
  // "Assist": Light utility (e.g., mini-maps, sorting inventory, mob HP display, balanced buffs)
  // "Turbo": Strong utility (e.g., vein mining, automation, ore radar, low-cost buffs, or moderate rule-bending features)
  // "Break": Rule-breaking mechanics (e.g., flight, portals, massive yield multipliers, low-cost or free powerful buffs)
  // "Godmode": God mode (e.g., invincibility, teleportation, infinite resources)
  // 玩法影响等级，用于标识模组对游戏平衡性的影响程度，有以下可选项：
  // "Cosmetic" 纯装饰品，例如材质包、字体包、光影
  // "Assist" 轻度辅助，例如小地图（不透视）、箱子整理、显示生物血量、合适成本提升玩家能力
  // "Turbo" 强力辅助，例如一键撸树、自动化、矿物雷达、低成本提升玩家能力、合适成本的规则破坏
  // "Break" 规则破坏，例如无/低成本地大幅提升玩家能力、飞行、传送门、掉落物/产量倍增
  // "Godmode" 上帝模式，例如无敌、瞬移、无限资源
  "GameplayImpactLevel": "Cosmetic",

  // Mod link. Accessible from the mod management screen. Recommended for documentation or bug reports.
  // 模组链接，玩家能从模组管理界面打开；建议设置为带有详细介绍的链接，或者能反馈 Bug 的链接
  "Link": "https://github.com/XiaofengdiZhu/SurvivalcraftTemplateModForAPI",

  // Mod author
  // 模组作者
  "Author": "销锋镝铸 XiaofengdiZhu",

  // Mod package name. Used for identification. If multiple mods share the same PackageName, none of them will be loaded.
  // 模组包名，用于区分不同模组，一旦有若干个模组有相同包名，它们将全部不会加载
  "PackageName": "xfdz.SurvivalcraftTemplateMod",

  // Other mods that this mod depends on. See the link below for formatting rules.
  // 该模组依赖的其他模组，填写规则详见
  // https://gitee.com/SC-SPM/SurvivalcraftApi/blob/SCAPI1.9/docs/ModInfoConfig.md
  "Dependencies": {},

  // Mod settings. See the link below for details.
  // 模组设置，详见
  // https://gitee.com/SC-SPM/SurvivalcraftApi/blob/SCAPI1.9/docs/ModSettings.md
  "Settings": [
    {
      "Id": "TemplateModSettingsGroup1", // 用于获取设置值，必须有
      "Name": "Settings Group 1", // 入口按钮的显示名称（支持国际化）
      "Title": "Adjust Template Mod Settings Group 1", // 点开按钮后，在左侧边栏显示的标题（支持国际化）
      "Items": [
        {
          "Id": "TemplateModSettingsItem1",
          "Name": "[TemplateMod/Settings/Group1:1]", // 等价于 LanguageControl.Get("TemplateMod", "Settings", "Group1", "1")
          "Description": "[TemplateMod/Settings/Group1:2]",
          "Type": "bool", // 基本类型、Game 命名空间之外的类型，需要写完整类名
          "Default": false,
          "Widget": "BoolButtonSettingWidget" // 必须为实现了 IModSettingItemWidget 接口且继承自 Widget 类的类名
        },
        {
          "Id": "TemplateModSettingsItem2",
          // 不写 Name 时，会自动尝试从 LanguageControl.Get("ModSettings", PackageName, Id 链, "Name") 获取，Description、Title 同理
          // 获取失败后，Name、Title 默认为 Id，Description 默认为空字符串
          "Type": "int",
          "Default": 0,
          "Widget": "NumberSliderSettingWidget",
          // Widget 可从 Descriptor.WidgetProperties 读取下面属性
          "WidgetProperties": {
            "MinValue": -10,
            "MaxValue": 10,
            "Granularity": 1
          }
        },
        {
          "Id": "TemplateModSettingsSubgroup1",
          "Name": "More Settings",
          "Title": "Adjust Template Mod More Settings",
          "Items": [
            // 省略，支持嵌套
          ]
        }
      ]
    },
    // 支持添加多个入口按钮，但因为 Items 为空，不会显示
    {
      "Id": "TemplateModSettingsGroup2",
      "Items": []
    }
  ]

  // You can remove the comments above.
  // 你可以删除上面的注释
}