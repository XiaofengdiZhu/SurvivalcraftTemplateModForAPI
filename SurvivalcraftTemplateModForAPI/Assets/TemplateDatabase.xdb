<Mod xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://gitee.com/SC-SPM/SurvivalcraftApi/raw/SCAPI1.9/Survivalcraft/Content/Assets/Database.xsd">
  <!-- Add SubsystemTemplate to the Project. The Guid attribute links this element to the original <ProjectTemplate Name="Project" …> -->
  <!-- 将 SubsystemTemplate 添加到 Project 中。此处的 Guid 属性用于将该元素和原本的 <ProjectTemplate Name="Project" …> 连接起来-->
  <ProjectTemplate Name="Project" Guid="85023bf8-1c90-4dd1-9442-e6c13691d078">
    <!-- The Guid attribute here should be a new random GUID, which does not point to any existing element -->
    <!-- 此处的 Guid 属性需要使用新生成的随机 GUID，它不指向任何已存在的元素 -->
    <MemberSubsystemTemplate Name="TemplateBlockBehavior" Guid="3f8d8e1a-6ff4-4327-b546-d8d17e0f49f6" InheritanceParent="fefb9590-4972-4893-b02a-76063611b745">
      <Parameter Name="Class" Guid="e0fe773f-c6e9-4fba-8211-72e25ef8a79f" Value="Game.SubsystemTemplateBlockBehavior" Type="string"/>
    </MemberSubsystemTemplate>
  </ProjectTemplate>
  <!-- Add ComponentTemplate to the Player -->
  <!-- 将ComponentTemplate添加到Player中 -->
  <EntityTemplate Name="Player" Guid="4be6c1c5-d65d-4537-8a8b-a391969e6dc2">
    <!-- The Guid attribute here makes this element inherit the <ComponentTemplate Name="ComponentTemplate" …> element below. So that you don't have to write <Parameter Name="Class" …> and <Parameter Name="LoadOrder" …> again. -->
    <!--此处的 InheritanceParent 属性将此元素继承下面的 <ComponentTemplate Name="ComponentTemplate" …>，这样就不用重复填 <Parameter Name="Class" …>、<Parameter Name="LoadOrder" …> -->
    <MemberComponentTemplate Name="ComponentTemplate" Guid="bb7b00c2-32b6-44b8-bf86-e3ed640caa99" InheritanceParent="28680941-ec24-4ebc-84b9-17d42de6204c"/>
  </EntityTemplate>
  <Folder Name="Gameplay" Guid="d3d4b692-acc9-4128-9b99-a5acf1de1fbb">
    <ComponentTemplate Name="ComponentTemplate" Guid="28680941-ec24-4ebc-84b9-17d42de6204c" InheritanceParent="b05700ed-7e4e-4679-98f5-b597f421496b">
      <Parameter Name="Class" Guid="794fe726-4fc3-48ea-97fd-651a5434cc97" Value="Game.ComponentTemplate" Type="string"/>
      <Parameter Name="LoadOrder" Guid="d9a3ef48-d3dd-480a-8b9d-f0ae675079fb" Value="2147483647" Type="int"/>
    </ComponentTemplate>
  </Folder>
  <!-- Change the egg color of white horse to black -->
  <!-- 将白马蛋的颜色修改为黑色 -->
  <Parameter Name="Color" Guid="480fe1d2-2474-4fa9-a984-9a999d61b1c9" new-Value="0,0,0" Type="Color"/>
  <!-- Change the walk speed of saddled white horse to 15 -->
  <!-- 将加鞍白马的行走速度修改为15 -->
  <EntityTemplate Name="Horse_White_Saddled" Guid="ba79c837-ba1d-4b21-af32-5e1f0a332206">
    <MemberComponentTemplate Name="Locomotion" Guid="52cada89-5c6c-457c-b074-448bec3d27cc">
      <Parameter Name="WalkSpeed" Guid="3ac123f0-0f1f-49e1-a405-6a603c09a0e3" Value="15" Type="float"/>
    </MemberComponentTemplate>
  </EntityTemplate>
  <!-- Remove a loot of seagull -->
  <!-- 删除海鸥的一个掉落物 -->
  <Parameter Name="2" Guid="c1e45187-f76b-4f1b-af54-c792698a07d9" Value="FeatherBlock;1;1" Type="string" Remove="true" />
  <!-- Add a new creature -->
  <!-- 添加一个新的生物 -->
  <EntityTemplate Name="Wererhino" Guid="d81caaef-1ebe-4339-b26c-e3a53ebd0200" InheritanceParent="4d02fd7e-3054-4121-b2a5-787db985df5f">
    <!-- Remove FourLeggedModel, add HumanModel -->
    <!-- 移除四足模型，添加人类模型 -->
    <MemberComponentTemplate Name="FourLeggedModel" Guid="e21c70a6-166d-4023-84ab-edef14f6ef72">
      <Parameter Name="Class" Guid="3f3c8c0f-c345-4e39-b993-cd75ccc23c48" Value="Game.ComponentNoEffect" Type="string" />
    </MemberComponentTemplate>
    <MemberComponentTemplate Name="HumanModel" Guid="19b55f2d-ccf6-40aa-8b73-85dbec9435a3" InheritanceParent="0566662e-bb24-45f9-84d8-f3c1e5d083df">
      <Parameter Name="WalkLegsAngle" Guid="26bef33a-82ae-4dc5-ae7c-d320fd620e09" Value="0.35" Type="float" />
      <Parameter Name="ModelName" Guid="d9cd780e-3d7f-4928-9c37-e622510c11d4" Value="Models/Werewolf" Type="string" />
      <Parameter Name="TextureOverride" Guid="e6fb4db1-84f6-4f4a-8c36-9cc079825e22" Value="Textures/Creatures/Rhino" Type="string" />
      <Parameter Name="WalkAnimationSpeed" Guid="6f546e89-37f4-4cfa-9a6b-4a72867877d0" Value="0.65" Type="float" />
      <Parameter Name="ModelScale" Guid="354f1469-f5c9-42ae-99b0-e49bb9aaa100" Value="2" Type="float" />
    </MemberComponentTemplate>
    <!-- Change the box size -->
    <!-- 修改碰撞箱大小 -->
    <MemberComponentTemplate Name="Body" Guid="9cadb6d5-e50d-47ae-a2ee-25c846286455">
      <Parameter Name="BoxSize" Guid="b9949f8f-fbc5-4bfc-9290-6ec03f4826f9" Value="1.4,3.6,1.4" Type="Vector3" />
    </MemberComponentTemplate>
    <MemberComponentTemplate Name="Creature" Guid="7e99fdd5-78f7-4618-92ff-bf7d193c3db2">
      <Parameter Name="Description" Guid="08c36c83-f1de-4edd-b86a-886dfa9b27ec" Value="[Description:4095]" Type="string" />
      <Parameter Name="DisplayName" Guid="3d63f78a-05e4-4f25-9342-639e1df7de84" Value="[DisplayName:4095]" Type="string" />
    </MemberComponentTemplate>
    <ParameterSet Name="CreatureEggData" Guid="4e327f1a-8e62-4b21-a1e2-b60c31492670">
      <Parameter Name="EggTypeIndex" Guid="b7099daa-67f1-4adc-a8c8-908c2a9ed063" Value="4095" Type="int" />
      <Parameter Name="SwapUV" Guid="6345f6f8-8106-45ab-977b-c08adfb304c9" Value="True" Type="bool" />
      <Parameter Name="DisplayName" Guid="58cb9b65-d688-4329-b773-3a5d804b0355" Value="[DisplayName:4096]" Type="string" />
    </ParameterSet>
  </EntityTemplate>
  <!-- Add a new auto creature spawn rule -->
  <!-- 添加一个新的生物自动生成规则 -->
  <ParameterSet Name="CreatureSpawnRules" Guid="98c19e0b-ff62-4acc-8e58-def30e6257a3">
    <!-- For this rule, check Game.StandardCreatureSpawnRule for more details -->
    <!-- 对于这条规则，请查看 Game.StandardCreatureSpawnRule 以了解更多 -->
    <ParameterSet Name="TemplateRuleWerewolf">
      <Parameter Name="Name" Value="Wererhino" Type="string" /><!-- Required. The name of EntityTemplate you want to spawn. 必填，你要生成的 EntityTemplate 的名称 -->
      <Parameter Name="Class" Value="Game.StandardCreatureSpawnRule" Type="string" /><!-- Required. The class of spawn rule. 必填，生成规则的类 -->
      <Parameter Name="SpawnLocationType" Value="Surface" Type="Game.SpawnLocationType" /><!-- Default 默认: Surface -->
      <Parameter Name="RandomSpawn" Value="True" Type="bool" /><!-- Default 默认: False -->
      <Parameter Name="ConstantSpawn" Value="false" Type="bool" /><!-- Default 默认: False -->
      <Parameter Name="MinTemperature" Value="5" Type="int" /><!-- Default 默认: 0 -->
      <Parameter Name="MaxTemperature" Value="15" Type="int" /><!-- Default 默认: 15 -->
      <Parameter Name="MinHumidity" Value="9" Type="int" /><!-- Default 默认: 0 -->
      <Parameter Name="MaxHumidity" Value="15" Type="int" /><!-- Default 默认: 15 -->
      <Parameter Name="AboveTopBlock" Value="True" Type="bool" /><!-- Default 默认: False -->
      <Parameter Name="MinShoreDistance" Value="40" Type="float" /><!-- Default 默认: -Infinity -->
      <Parameter Name="MaxShoreDistance" Value="Infinity" Type="float" /><!-- Default 默认: Infinity -->
      <Parameter Name="Blocks" Value="LeavesBlock;WaterBlock;GrassBlock;DirtBlock" Type="string" /><!-- Default: (None) 默认: （无） -->
      <Parameter Name="Suitability" Value="2.5" Type="float" /><!-- Default 默认: 1 -->
      <Parameter Name="Count" Value="1" Type="int" /><!-- Default 默认: 1 -->
    </ParameterSet>
  </ParameterSet>
</Mod>